# Copy to .env. Values here are the LOCAL (host) defaults — running against
# services on localhost. docker-compose overrides the hostnames with Docker
# service names (postgres, opensearch, redis, ollama, airflow-webserver),
# because inside a container "localhost" is the container itself.

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Postgres (document metadata, users, chat history) ────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# ── OpenSearch (BM25 + kNN hybrid search) ────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=chunks

# ── Embeddings (in-process, no separate service) ─────────────────────────────
# jina-embeddings-v3 natively emits 1024 dims and is Matryoshka-trained, so
# EMBEDDING_DIM selects a truncation width from
# [32, 64, 128, 256, 512, 768, 1024]. 768 buys a 25% smaller index and faster
# kNN; it does NOT reduce model memory (the forward pass is still 1024 wide and
# peaks ~5.4GB RSS on CPU).
#
# EMBEDDING_DIM must match the knn_vector dimension of the OpenSearch index.
# Changing it means deleting and recreating that index.
EMBEDDING_MODEL=jinaai/jina-embeddings-v3
EMBEDDING_DIM=768
# jina-v3 routes through task-specific LoRA adapters. Ingestion embeds
# passages; search-time query embedding uses "retrieval.query".
EMBEDDING_TASK=retrieval.passage
EMBEDDING_BATCH_SIZE=8

# ── Ingestion ────────────────────────────────────────────────────────────────
# Bind-mounted into Airflow at /opt/airflow/inbox (see docker-compose.yml) —
# must be a real host folder since the app runs on the host, not in Docker.
# Run uvicorn from the project root so this relative path resolves correctly.
INBOX_DIR=./data/inbox
ARXIV_CATEGORY=cs.AI
ARXIV_MAX_PAPERS=10

# ── Airflow (DAG trigger from POST /ingest) ──────────────────────────────────
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# ── Redis (Phase 3: caching, rate limiting) ──────────────────────────────────
# Host port 6380, not the Redis default 6379 — pick whatever's free on your
# machine if 6380 is also taken by something else.
REDIS_URL=redis://localhost:6380/0

# ── Ollama (Step 1.7: RAG generation) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
