    {
      "id": "fr2-body-text",
      "type": "text",
      "x": 32, "y": 415, "width": 936, "height": 118,
      "angle": 0,
      "strokeColor": "#1b4332",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
