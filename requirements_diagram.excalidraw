      "seed": 2010, "version": 1, "versionNonce": 2010,
      "isDeleted": false, "boundElements": [],
      "updated": 1721000000000, "link": null, "locked": false,
      "text": "•  99.5% uptime SLA target\n•  Graceful degradation: fallback answers when LLM or search is unavailable\n•  Idempotent ingestion pipeline — zero duplicate documents\n•  Redis semantic + exact cache to absorb repeated queries",
      "fontSize": 13, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "baseline": 13, "containerId": null,
      "originalText": "•  99.5% uptime SLA target\n•  Graceful degradation: fallback answers when LLM or search is unavailable\n•  Idempotent ingestion pipeline — zero duplicate documents\n•  Redis semantic + exact cache to absorb repeated queries",
      "lineHeight": 1.5
    },
