      "isDeleted": false, "boundElements": [],
      "updated": 1721000000000, "link": null, "locked": false,
      "text": "•  Ingest any document type: PDF, Word (.docx), Markdown, HTML, arXiv API\n•  Upload via REST: POST /documents  (multipart file upload)\n•  Store raw originals in MinIO blob storage (S3-compatible API)\n•  Parse & extract structured content using Docling\n•  Daily automated arXiv sync via Airflow DAG",
      "fontSize": 13, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "baseline": 13, "containerId": null,
      "originalText": "•  Ingest any document type: PDF, Word (.docx), Markdown, HTML, arXiv API\n•  Upload via REST: POST /documents  (multipart file upload)\n•  Store raw originals in MinIO blob storage (S3-compatible API)\n•  Parse & extract structured content using Docling\n•  Daily automated arXiv sync via Airflow DAG",
      "lineHeight": 1.5
    },
