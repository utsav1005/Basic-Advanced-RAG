      "seed": 2006, "version": 1, "versionNonce": 2006,
      "isDeleted": false, "boundElements": [],
      "updated": 1721000000000, "link": null, "locked": false,
      "text": "•  Hybrid search latency < 500 ms at P95\n•  LLM first-token streaming latency < 2 seconds\n•  Ingestion throughput: >= 100 documents / hour\n•  Non-LLM API endpoints respond in < 200 ms",
      "fontSize": 13, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "baseline": 13, "containerId": null,
      "originalText": "•  Hybrid search latency < 500 ms at P95\n•  LLM first-token streaming latency < 2 seconds\n•  Ingestion throughput: >= 100 documents / hour\n•  Non-LLM API endpoints respond in < 200 ms",
      "lineHeight": 1.5
    },
