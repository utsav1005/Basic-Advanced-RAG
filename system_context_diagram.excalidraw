    {
      "id": "sc-system-desc",
      "type": "text",
      "x": 520, "y": 428, "width": 660, "height": 120,
      "angle": 0,
      "strokeColor": "#e0e7ff", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null,
      "seed": 5006, "version": 1, "versionNonce": 5006,
      "isDeleted": false, "boundElements": [],
      "updated": 1721000000000, "link": null, "locked": false,
      "text": "Ingests any document: PDF, Word (.docx), Markdown, HTML, arXiv.\nBuilds a hybrid BM25 + vector search index (OpenSearch).\nAnswers natural language questions with cited, streaming responses.\nServes users via REST API, Gradio Web UI, and Telegram Bot.\nPersonalizes results per user profile and reading history.",
      "fontSize": 12, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "top",
      "baseline": 11, "containerId": null,
      "originalText": "Ingests any document: PDF, Word (.docx), Markdown, HTML, arXiv.\nBuilds a hybrid BM25 + vector search index (OpenSearch).\nAnswers natural language questions with cited, streaming responses.\nServes users via REST API, Gradio Web UI, and Telegram Bot.\nPersonalizes results per user profile and reading history.",
      "lineHeight": 1.5
    },

